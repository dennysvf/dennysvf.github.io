---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { alternatesFor, useTranslations, type Locale } from '../i18n/ui';
import { publishedArticles } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const articles = await publishedArticles();
---

<Base locale={locale} title={t.articles.eyebrow} description={t.articles.metaDescription} alternates={alternatesFor('articles')}>
  <section class="wrap page">
    <p class="eyebrow">{t.articles.eyebrow}</p>
    <h1 class="display">{t.articles.title} <em>{t.articles.titleEm}</em></h1>
    <p class="lead">{t.articles.lead}</p>
    <div class="list-wrap">
      <ArticleList articles={articles} locale={locale} />
    </div>
  </section>
</Base>

<style>
  .page { padding-block: clamp(3rem, 8vw, 5rem); }
  h1 { font-size: clamp(2.75rem, 7vw, 4.5rem); margin: 0.75rem 0 1rem; }
  h1 em { color: var(--accent); }
  .lead { max-width: 40rem; color: var(--muted); margin: 0 0 3rem; }
  .list-wrap { border-top: 1px solid var(--line); }
</style>
