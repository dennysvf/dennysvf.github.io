---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { alternatesFor, useTranslations, type Locale } from '../i18n/ui';
import { getProjects } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<Base locale={locale} title={t.projects.eyebrow} description={t.projects.metaDescription} alternates={alternatesFor('projects')}>
  <section class="wrap page">
    <p class="eyebrow">{t.projects.eyebrow}</p>
    <h1 class="display">{t.projects.title} <em>{t.projects.titleEm}</em></h1>
    <p class="lead">{t.projects.lead}</p>
    <div class="grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} locale={locale} />)}
    </div>
  </section>
</Base>

<style>
  .page { padding-block: clamp(3rem, 8vw, 5rem); }
  h1 { font-size: clamp(2.75rem, 7vw, 4.5rem); margin: 0.75rem 0 1rem; }
  h1 em { color: var(--accent); }
  .lead { max-width: 40rem; color: var(--muted); margin: 0 0 3rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 1.25rem; }
</style>
