---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleList from '../components/ArticleList.astro';
import { SITE } from '../consts';
import { alternatesFor, localizedPath, useTranslations, type Locale } from '../i18n/ui';
import { getProjects, publishedArticles } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = (await getProjects(locale)).filter((p) => p.data.featured);
const articles = (await publishedArticles()).slice(0, 3);
---

<Base locale={locale} alternates={alternatesFor('home')}>
  <section class="hero wrap">
    <p class="eyebrow">{t.role}</p>
    <h1 class="display">
      {t.home.heroLine1}<br />
      <em>{t.home.heroLine2}</em>
    </h1>
    <p class="lead">{t.home.lead(SITE.name)}</p>
    <div class="cta">
      <a class="btn primary" href={localizedPath(locale, 'projects')}>{t.home.ctaProjects}</a>
      <a class="btn" href={SITE.github}>GitHub ↗</a>
    </div>
    <p class="mono terminal" aria-label={t.home.terminalAria}>
      <span class="prompt">$</span> {t.home.terminalCmd} <span class="out">{t.home.terminalOut}</span>
    </p>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">{t.home.projectsTitle}</h2>
        <a class="mono" href={localizedPath(locale, 'projects')}>{t.home.allProjects}</a>
      </div>
      <div class="grid">
        {projects.map((project, i) => <ProjectCard project={project} index={i} locale={locale} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">{t.home.howTitle}</h2>
      </div>
      <ol class="steps">
        {t.home.steps.map((step, i) => (
          <li>
            <span class="mono step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">{t.home.articlesTitle}</h2>
        <a class="mono" href={localizedPath(locale, 'articles')}>{t.home.allArticles}</a>
      </div>
      <ArticleList articles={articles} locale={locale} variant="compact" />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(4rem, 12vw, 9rem) clamp(3rem, 8vw, 5rem); }
  h1 { font-size: clamp(3rem, 9vw, 6.5rem); margin: 1rem 0 1.5rem; }
  h1 em { color: var(--accent); }
  .lead { max-width: 38rem; font-size: 1.1875rem; color: var(--muted); margin: 0 0 2rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
  }
  .btn:hover { border-color: var(--accent); color: var(--text); }
  .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .btn.primary:hover { color: var(--accent-ink); filter: brightness(1.08); }
  .terminal { margin-top: 3rem; color: var(--muted); overflow-wrap: anywhere; }
  .prompt, .out { color: var(--accent); }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 1.25rem; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1.25rem; }
  .steps li { border-top: 2px solid var(--accent); padding-top: 1rem; }
  .step-num { color: var(--muted); }
  .steps h3 { margin: 0.5rem 0; font-size: 1.125rem; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.9875rem; }
</style>
