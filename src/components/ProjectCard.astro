---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projetos'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, tagline, summary, stack, status, aiOnly, stats } = project.data;
const number = String(index + 1).padStart(2, '0');
---

<article class="card">
  <a href={`/projetos/${project.id}`} class="cover-link" aria-label={`Ver projeto ${title}`}></a>
  <div class="top">
    <span class="mono num">{number}</span>
    <div class="badges">
      {aiOnly && <span class="ai-badge">100% IA</span>}
      <span class="tag">{status}</span>
    </div>
  </div>
  <h3 class="display">{title}</h3>
  <p class="tagline">{tagline}</p>
  <p class="summary">{summary}</p>
  {stats.length > 0 && (
    <dl class="stats">
      {stats.map((s) => (
        <div>
          <dt class="mono">{s.label}</dt>
          <dd class="display">{s.value}</dd>
        </div>
      ))}
    </dl>
  )}
  <ul class="stack">
    {stack.slice(0, 6).map((tech) => <li class="tag">{tech}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .cover-link { position: absolute; inset: 0; border-radius: inherit; z-index: 1; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .num { color: var(--muted); }
  .badges { display: flex; gap: 0.5rem; }
  h3 { font-size: clamp(2.25rem, 5vw, 3rem); margin: 0.5rem 0 0; }
  .tagline { margin: 0; color: var(--accent); font-family: var(--font-mono); font-size: 0.875rem; }
  .summary { margin: 0; color: var(--muted); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 0.5rem 0; padding: 1rem 0; border-block: 1px solid var(--line); }
  .stats div { display: flex; flex-direction: column; }
  .stats dd { order: -1; margin-bottom: 0.3rem; }
  dt { color: var(--muted); font-size: 0.6875rem; line-height: 1.3; }
  dd { margin: 0; font-size: 2rem; line-height: 1; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: auto 0 0; padding: 0; }
</style>
