---
import Base from '../../layouts/Base.astro';
import { articleHref, formatDate, publishedArticles } from '../../lib/content';

const articles = await publishedArticles();
---

<Base title="Artigos" description="Textos sobre desenvolvimento orientado por IA, arquitetura e processo.">
  <section class="wrap page">
    <p class="eyebrow">Artigos</p>
    <h1 class="display">Notas de quem <em>delega o teclado.</em></h1>
    <p class="lead">Processo, arquitetura e lições aprendidas construindo software só com agentes de IA.</p>

    {articles.length === 0 ? (
      <p class="empty">Os primeiros textos estão a caminho. Acompanhe pelo <a href="/rss.xml">RSS</a>.</p>
    ) : (
      <ul class="list">
        {articles.map((a) => (
          <li>
            <a href={articleHref(a)}>
              <span class="mono date">{formatDate(a.data.pubDate)}</span>
              <div>
                <h2>{a.data.title}{a.data.draft && <span class="tag draft">rascunho</span>}</h2>
                <p>{a.data.description}</p>
                <p class="mono where">
                  {a.data.externalUrl ? 'LinkedIn ↗' : 'ler aqui →'}
                  {a.data.tags.map((t) => <span>#{t}</span>)}
                </p>
              </div>
            </a>
            {a.data.externalUrlEn && (
              <a class="mono en" href={a.data.externalUrlEn} hreflang="en">English version ↗</a>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .page { padding-block: clamp(3rem, 8vw, 5rem); }
  h1 { font-size: clamp(2.75rem, 7vw, 4.5rem); margin: 0.75rem 0 1rem; }
  h1 em { color: var(--accent); }
  .lead { max-width: 40rem; color: var(--muted); margin: 0 0 3rem; }
  .empty { color: var(--muted); }
  .list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .list a { display: grid; grid-template-columns: 8rem 1fr; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .list a:hover h2 { color: var(--accent); }
  .date { color: var(--muted); padding-top: 0.35rem; }
  h2 { font-family: var(--font-display); font-weight: 400; font-size: 1.75rem; line-height: 1.15; margin: 0 0 0.35rem; }
  .list p { margin: 0; color: var(--muted); }
  .draft { margin-left: 0.75rem; vertical-align: middle; }
  .list li { position: relative; border-bottom: 1px solid var(--line); }
  .list a { border-bottom: none; }
  .list .where { margin-top: 0.6rem; color: var(--accent); display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .list .where span { color: var(--muted); }
  .list .en { display: block; padding: 0 0 1.25rem 9.5rem; margin-top: -0.75rem; color: var(--muted); text-decoration: none; }
  .list .en:hover { color: var(--accent); }
  @media (max-width: 40rem) {
    .list a { grid-template-columns: 1fr; gap: 0.25rem; }
    .list .en { padding-left: 0; }
  }
</style>
