---
import Base from '../layouts/Base.astro';
import { alternatesFor, LOCALES, localizedPath, useTranslations } from '../i18n/ui';

// O GitHub Pages serve um único 404 para todos os idiomas, então mostramos os três.
const messages = LOCALES.map((locale) => ({ locale, t: useTranslations(locale) }));
---

<Base locale="pt" title={messages[0].t.notFound.title} alternates={alternatesFor('home')} equivalent={false}>
  <section class="wrap page">
    <p class="mono"><span class="accent">404</span> · {messages[0].t.notFound.tagline}</p>
    <h1 class="display">{messages[0].t.notFound.title}.</h1>
    <ul>
      {messages.map(({ locale, t }) => (
        <li><a href={localizedPath(locale, 'home')} hreflang={locale}>{t.notFound.back}</a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page { padding-block: clamp(5rem, 15vw, 10rem); }
  .accent { color: var(--accent); }
  h1 { font-size: clamp(2.75rem, 8vw, 5rem); margin: 1rem 0 2rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
</style>
