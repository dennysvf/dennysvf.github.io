---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projetos')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projetos" description="Projetos construídos inteiramente por agentes de IA.">
  <section class="wrap page">
    <p class="eyebrow">Projetos</p>
    <h1 class="display">Software real, <em>zero linhas à mão.</em></h1>
    <p class="lead">
      Cada projeto aqui foi especificado por mim e implementado por agentes de IA, sem edição manual de código.
      Os repositórios são públicos: o histórico de commits conta a história inteira.
    </p>
    <div class="grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>
</Base>

<style>
  .page { padding-block: clamp(3rem, 8vw, 5rem); }
  h1 { font-size: clamp(2.75rem, 7vw, 4.5rem); margin: 0.75rem 0 1rem; }
  h1 em { color: var(--accent); }
  .lead { max-width: 40rem; color: var(--muted); margin: 0 0 3rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 1.25rem; }
</style>
